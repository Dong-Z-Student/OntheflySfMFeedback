<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Imported before Microsoft.Cpp.props for Release/x64 only. -->
  <PropertyGroup Label="LocalWindowsSetup">
    <LocalSfMRoot>E:\sfm\OntheflySfMFeedback\</LocalSfMRoot>
    <LocalPythonRoot>E:\sfm\envs\feedback310\</LocalPythonRoot>
    <LocalTbbRoot>E:\sfm\onetbb\</LocalTbbRoot>
    <LocalCudaRoot>D:\CUDA\v12.2\</LocalCudaRoot>
    <PlatformToolset>v143</PlatformToolset>
    <VCToolsVersion>14.36.32532</VCToolsVersion>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <QtMsBuild>C:\Users\Zhushunhao\AppData\Local\QtMsBuild</QtMsBuild>
    <QtInstall>5.12.12_msvc2017_64</QtInstall>
    <QtBuildConfig>release</QtBuildConfig>
    <CudaToolkitCustomDir>$(LocalCudaRoot)</CudaToolkitCustomDir>
    <UseInteloneTBB>false</UseInteloneTBB>
    <UseInteloneMKL>No</UseInteloneMKL>
    <VcpkgRoot>E:\sfm\vcpkg\</VcpkgRoot>
    <VcpkgEnabled>true</VcpkgEnabled>
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgManifestRoot>$(LocalSfMRoot)</VcpkgManifestRoot>
    <VcpkgInstalledDir>$(LocalSfMRoot)vcpkg_installed\</VcpkgInstalledDir>
    <VcpkgTriplet>x64-windows</VcpkgTriplet>
    <VcpkgHostTriplet>x64-windows</VcpkgHostTriplet>
    <!-- S08 already installed and verified this manifest. Install explicitly when dependencies change. -->
    <VcpkgManifestInstall>false</VcpkgManifestInstall>
    <VcpkgAdditionalInstallOptions>--overlay-triplets=&quot;E:\sfm\triplets&quot; --overlay-ports=&quot;E:\sfm\overlay-ports&quot;</VcpkgAdditionalInstallOptions>
    <OutDir>E:\sfm\runtime\Release\</OutDir>
    <IntDir>E:\sfm\build\obj\$(MSBuildProjectName)\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
</Project>
